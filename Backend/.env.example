# Copier ce fichier vers .env et renseigner les valeurs.
# .env ne doit jamais être versionné.

# Chaîne de connexion PostgreSQL, identifiants compris.
# En développement, « npm run db:dev » démarre une base embarquée et affiche
# la valeur à coller ici.
DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/etabli?schema=public

# Secret de signature des jetons. Générer une valeur aléatoire longue :
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
TOKEN_SECRET=

# Origine autorisée pour le client. Plusieurs valeurs possibles, séparées par des virgules.
CLIENT_URL=http://localhost:3000

PORT=5000
NODE_ENV=development

# Tentatives de connexion ou d'inscription autorisées par tranche de 15 minutes.
# Par défaut : 20 en production, 500 ailleurs, afin qu'une suite de tests de
# bout en bout ne se heurte pas à la limite.
# AUTH_RATE_LIMIT=20
