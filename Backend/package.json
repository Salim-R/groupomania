{
  "name": "etabli-api",
  "version": "2.0.0",
  "description": "API de l'Établi : carnet de bord public pour artisans et créateurs.",
  "main": "server.js",
  "author": "Salim Rhamoumi",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:dev": "node scripts/dev-db.js",
    "db:seed": "node prisma/seed.js",
    "db:migrate": "prisma migrate deploy",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:watch": "cross-env NODE_ENV=test jest --runInBand --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --runInBand --coverage",
    "lint": "eslint .",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jose": "^5.10.0",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "cross-env": "^7.0.3",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.18.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prisma": "^6.19.3",
    "supertest": "^7.0.0"
  }
}
