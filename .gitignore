# Dépendances
node_modules/

# Variables d'environnement : jamais versionnées.
# Seul .env.example, sans valeurs réelles, est suivi.
.env
.env.*
!.env.example

# Fichiers déposés par les utilisateurs
Backend/uploads/
!Backend/uploads/.gitkeep

# Constructions
build/
dist/
.next/
coverage/

# Base de développement embarquée : régénérée par « npm run db:dev »
Backend/.postgres-dev/

# Sorties des tests de bout en bout
web/test-results/
web/playwright-report/
web/blob-report/
web/.playwright/

# Journaux
*.log
npm-debug.log*

# Éditeurs et systèmes
.vscode/
.idea/
.DS_Store
Thumbs.db
