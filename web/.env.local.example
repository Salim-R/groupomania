# Copier vers .env.local

# Adresse de l'API. Exposée au navigateur : ne jamais y mettre de secret.
# Le préfixe NEXT_PUBLIC_ signifie que la valeur est inscrite dans le bundle
# envoyé au client. C'est précisément la faille de la version précédente, qui
# plaçait le mot de passe de la base derrière un préfixe REACT_APP_.
NEXT_PUBLIC_API_URL=http://localhost:5000
